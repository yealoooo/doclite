# doclite server 配置模板。复制为 server/.env 后按需修改（server/.env 不提交）。
# 读取顺序：先读当前目录下的 .env（在 server/ 目录里运行 `go run ./cmd/server` 时就是这个文件），再读环境变量；
# 同名时环境变量优先。空值等于没设置。

# PostgreSQL 连接串（必填）。本机开发用 doclite_dev 库；server 启动时自动执行 migrations/ 下的迁移。
# API 测试不读这一项，测试库地址见 TEST_DATABASE_URL（默认 postgres://doclite@127.0.0.1:5432/doclite_test）。
DATABASE_URL=postgres://doclite@127.0.0.1:5432/doclite_dev

# HTTP 监听地址，格式 IP:端口。不设置时默认 0.0.0.0:9080（容器里要监听所有地址）；本机开发建议只监听 127.0.0.1。
LISTEN_ADDR=127.0.0.1:9080

# 临时文件目录：上传时先写到这里再传到 S3，导出时在这里生成 PDF。生产环境指向磁盘上的 tmp 卷（不要用 tmpfs）。
# 不设置时是系统临时目录下的 doclite 子目录。启动时自动创建。
TMP_DIR=/tmp/doclite

# 日志级别：debug、info、warn、error，不设置时为 info。info 级别每个 /api 请求记一行；debug 另外记网页的静态文件。
# （上一版用 RUST_LOG，这一版不再读它。）
LOG_LEVEL=info

# ---- 登录和会话 ----

# 会话有效期（小时），1 到 720 的整数，不设置时为 12。从登录时起算，到期后要重新登录，期间有操作也不会延长。
# Cookie 的 Max-Age 也是这个值：关掉浏览器再打开，在有效期内仍然是登录状态。
SESSION_TTL_HOURS=12

# 会话 Cookie 是否带 Secure 属性（true/false），不设置时为 false。带了之后浏览器只在 https 下发送 Cookie，
# 用 http 访问就登录不上。客户内网多是 http；前面有 https 反向代理时再打开。
COOKIE_SECURE=false

# 初始管理员：server 启动时，如果系统里一个用户都没有，就用下面的登录名和密码建一个 admin 角色的用户。
# 已经有用户时不再使用（可以删掉）。登录名和密码要同时设置（登录名不能有空格，密码 6 到 128 个字符）；
# 都不设置而且系统里没有用户时，server 照常启动，但会打一条警告，这时谁都无法登录。
# 生产环境请换成强密码，首次登录后修改。
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-now
# 初始管理员的姓名，不设置时为"系统管理员"。
# INIT_ADMIN_DISPLAY_NAME=系统管理员

# ---- 主密钥 ----

# 主密钥（必填）：加密保存在数据库里的密钥（存储配置的 secret_key）。
# 格式：32 字节随机数的标准 base64（44 个字符），每个环境单独生成一个：
#   openssl rand -base64 32
# 没设置或格式不对时 server 启动报错退出。设置后不要再改，也不要丢：换了之后，已保存的 secret_key 就解不开了。
# 启动日志里的 master_key_id 是它的指纹（不泄露密钥），可以用来核对两处的 MASTER_KEY 是否一致。
MASTER_KEY=

# ---- 首次启动登记默认存储（M1-3 起生效）----

# server 启动时，如果系统里一条存储配置都没有，就用下面的 S3_* 登记一条默认存储。已经有存储配置时不再使用，
# 之后改存储配置请到系统管理的"存储配置"。S3_ENDPOINT、S3_BUCKET、S3_ACCESS_KEY、S3_SECRET_KEY 要么都设置，
# 要么都不设置。下面的值和 CLAUDE.md 里本机 weed mini 的启动命令一致。
S3_ENDPOINT=http://127.0.0.1:8333
# 工作站访问 S3 的地址（预签名 URL 用它），不设置时和 S3_ENDPOINT 相同。
# S3_PUBLIC_ENDPOINT=http://192.168.1.10:8333
S3_BUCKET=doclite
S3_ACCESS_KEY=doclite-dev
S3_SECRET_KEY=doclite-dev-secret
# S3_REGION=us-east-1
# 对象 key 的统一前缀，以 / 结尾，不设置时为 doclite/。
# S3_PATH_PREFIX=doclite/
# S3_FORCE_PATH_STYLE=true
# 发给工作站的预签名 URL 有效期（小时），1 到 168，不设置时为 24。
# S3_URL_EXPIRE_HOURS=24

# ---- 界面托管 ----

# web 构建产物的目录（web/ 下 npm run build 的输出）。设置后 server 同时托管界面，浏览器直接打开
# http://<server>:9080/ 就能用（/api 以外的路径返回页面，找不到的前端路由回退到 index.html）。
# 相对路径按 server 的工作目录解析：在 server/ 下运行时，../web/dist 就是仓库里的 web/dist。
# 不设置时不托管界面（只提供 /api）。目录不存在时只打一条警告，之后 build 出来不用重启。
WEB_DIR=../web/dist

# ---- 客户端（桌面客户端）版本 ----

# 最低客户端版本（semver，例如 1.2.0）。桌面客户端的每个请求都带 X-Client-Version，低于这个版本的请求返回
# 426 client_upgrade_required，客户端提示更新；格式不对返回 400 invalid_client_version。浏览器不带这个头，不受影响。
# 不设置时不限制。/api/health 和 /api/shell/* 不检查。只在接口不兼容时调高。
# MIN_CLIENT_VERSION=
# 最新的客户端版本（不能低于 MIN_CLIENT_VERSION）和下载地址，只用来告诉客户端（426 的 details）。
# CLIENT_LATEST_VERSION=
# CLIENT_DOWNLOAD_URL=

# ---- 上传 ----

# 上传原图的大小上限（字节），不设置时为 536870912（512 MiB）。超过时返回 413 payload_too_large。
# 原图边收边写到 TMP_DIR 下的临时文件（TMP_DIR/uploads/），所以临时目录要放得下"同时上传的个数 × 这个上限"。
# MAX_UPLOAD_BYTES=536870912
# 原图像素总数（宽 × 高）的上限，不设置时为 300000000（3 亿）。超过时返回 400 invalid_image。
# MAX_IMAGE_PIXELS=300000000
